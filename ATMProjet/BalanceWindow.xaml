<Window x:Class="ATMProjet.BalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ATMProjet"
        mc:Ignorable="d"
        Title="BalanceWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Solde actuel:" FontSize="20" Margin="10"/>
            <TextBlock Text="15000€" FontSize="30" FontWeight="Bold" Margin="10"/>
            <Button Content="Retour" Width="100" Height="30" Margin="10" Click="Return_Click"/>
        </StackPanel>
    </Grid>
</Window>
