<Window x:Class="ATMProjet.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ATMProjet"
        mc:Ignorable="d"
        Title="MenuWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Consulter le solde" Width="200" Height="50" Margin="137,128,63,39" Click="ViewBalance_Click" Grid.Column="0" Grid.Row="0"/>
        <Button Content="Retirer de l'argent" Width="200" Height="50" Margin="63,128,137,39" Click="WithdrawMoney_Click" Grid.Column="1" Grid.Row="0"/>
        <Button Content="Déposer de l'argent" Width="200" Height="50" Margin="137,41,63,126" Click="DepositMoney_Click" Grid.Column="0" Grid.Row="1"/>
    </Grid>
</Window>