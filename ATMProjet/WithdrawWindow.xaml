<Window x:Class="ATMProjet.WithdrawWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ATMProjet"
        mc:Ignorable="d"
        Title="WithdrawWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Choisir un montant:" FontSize="20" Margin="10"/>
            <Button Content="20€" Width="100" Height="30" Margin="10" Click="Withdraw_Click"/>
            <Button Content="50€" Width="100" Height="30" Margin="10" Click="Withdraw_Click"/>
            <Button Content="100€" Width="100" Height="30" Margin="10" Click="Withdraw_Click"/>
            <Button Content="Autre montant" Width="100" Height="30" Margin="10" Click="OtherAmount_Click"/>
            <TextBox Name="OtherAmountTextBox" Width="100" Height="30" Visibility="Collapsed" Margin="10"/>
            <Button Name="ConfirmButton" Content="Confirmer" Width="100" Height="30" Margin="10" Visibility="Collapsed" Click="Confirm_Click"/>
            <Button Content="Retour" Width="100" Height="30" Margin="10" Click="Return_Click"/>
        </StackPanel>
    </Grid>
</Window>