<Window x:Class="ATMProjet.DepositWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:ATMProjet"
         mc:Ignorable="d"
         Title="DepositWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Entrer le montant à déposer:" FontSize="20" Margin="10"/>
            <TextBox Width="100" Height="30" Margin="10"/>
            <Button Content="Déposer" Width="100" Height="30" Margin="10" Click="Deposit_Click"/>
            <Button Content="Retour" Width="100" Height="30" Margin="10" Click="Return_Click"/>
        </StackPanel>
    </Grid>
</Window>